{
  "name": "Avaliacao",
  "type": "object",
  "properties": {
    "imovel_id": {
      "type": "string"
    },
    "nota": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "texto": {
      "type": "string"
    },
    "autor_nome": {
      "type": "string"
    }
  },
  "required": [
    "imovel_id",
    "nota",
    "texto",
    "autor_nome"
  ],
  "rls": {
    "read": {},
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}